#!/usr/bin/env bash
# Rebuilds CHANGELOG.md and README.md's "Recent Changes" section after every
# commit, then folds that update into the commit you just made (so you never
# end up with a separate "update changelog" commit cluttering history).

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
LOCK_FILE="$REPO_ROOT/.git/.changelog-hook-lock"

# Guard against an infinite loop: the `git commit --amend` below would
# normally re-trigger this same post-commit hook.
if [ -f "$LOCK_FILE" ]; then
  rm -f "$LOCK_FILE"
  exit 0
fi

python3 "$REPO_ROOT/scripts/update_changelog.py"

cd "$REPO_ROOT"
if ! git diff --quiet -- CHANGELOG.md README.md; then
  git add CHANGELOG.md README.md
  touch "$LOCK_FILE"
  git commit --amend --no-edit --no-verify
fi
